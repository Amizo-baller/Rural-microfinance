# Local Hardhat RPC (backend connects on this computer).
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Fill these locally for Sepolia. Never paste private keys into chat or commit .env.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Optional separate backend signing wallet; otherwise the Sepolia deployer is used.
# API_WRITER_ADDRESS must match BLOCKCHAIN_PRIVATE_KEY's public address.
API_WRITER_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
