{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "ignoreDeprecations": "5.0"
  }
}
