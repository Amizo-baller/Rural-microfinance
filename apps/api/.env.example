DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rural_microfinance?schema=public"
API_PORT=3000
NODE_ENV=development
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=15m
GOOGLE_WEB_CLIENT_ID=749463098757-k1rt62cfef6vs05j5sb6kupborrvuoqm.apps.googleusercontent.com
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Set by npm run chain:configure:local after deployment.
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Online checkout: monime, flutterwave, or paystack.
PAYMENT_PROVIDER=monime
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
MONIME_API_BASE_URL=https://api.monime.io
# Signing Secret from the Monime webhook configuration (server-only).
MONIME_WEBHOOK_SECRET=
# Optional HTTPS page to return to after Monime checkout. Leave empty to use Monime's result page.
PAYMENT_RETURN_URL=

# Web origin shown in wallet sign-in requests; use the public HTTPS app origin in production.
# The phone setup helper supplies the computer's LAN origin for local Expo testing.
WALLET_AUTH_ORIGIN=http://localhost:8084
