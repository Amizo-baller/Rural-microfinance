{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "live": {
      "extends": "preview",
      "environment": "production",
      "env": {
        "RCM_LIVE_BUILD": "1"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "RCM_LIVE_BUILD": "1"
      }
    }
  }
}
