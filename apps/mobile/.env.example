EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Production: replace this with your reachable hosted API URL ending in /api.
# Native development: the app resolves localhost against Expo's desktop host.
# Web deployments with a reverse proxy may use EXPO_PUBLIC_API_URL=/api.

# MetaMask native login: optional dapp website identity (defaults to the API origin).
# EXPO_PUBLIC_WALLET_APP_URL=https://your-app.example
# Authentication only; signing a login message does not make a transaction.
EXPO_PUBLIC_WALLET_CHAIN_ID=0x1
EXPO_PUBLIC_WALLET_RPC_URL=https://cloudflare-eth.com
