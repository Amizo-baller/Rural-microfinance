{
  "name": "@rcm/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "node start-dev-client.cjs --dev-client --lan --port 8084",
    "android": "expo start --go --android",
    "android:dev": "expo run:android --variant debug",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:calendar": "node --test tests/date-field.browser.cjs",
    "test:acceptance": "playwright test",
    "build:review": "expo export --platform web --max-workers 1 --output-dir dist-review",
    "start:tunnel": "expo start --go --tunnel --port 8084 --max-workers 1"
  },
  "dependencies": {
    "@metamask/connect-evm": "2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "arg": "^5.0.2",
    "buffer": "6.0.3",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-image-picker": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "getenv": "^2.0.0",
    "ms": "^2.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "1.11.0",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "readable-stream": "4.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.24.0",
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.30.1"
  }
}
