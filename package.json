{
  "name": "rural-community-microfinance",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@rcm/api",
    "dev:mobile": "npm run start --workspace=@rcm/mobile",
    "chain": "npm run node --workspace=@rcm/contracts",
    "chain:compile": "npm run compile --workspace=@rcm/contracts",
    "chain:test": "npm run test --workspace=@rcm/contracts",
    "chain:typecheck": "npm run typecheck --workspace=@rcm/contracts",
    "chain:deploy:local": "npm run deploy:local --workspace=@rcm/contracts",
    "chain:deploy:sepolia": "npm run deploy:sepolia --workspace=@rcm/contracts",
    "chain:configure:local": "node scripts/blockchain-tools.cjs configure local",
    "chain:configure:sepolia": "node scripts/blockchain-tools.cjs configure sepolia",
    "chain:check:local": "node scripts/blockchain-tools.cjs check local",
    "chain:check:sepolia": "node scripts/blockchain-tools.cjs check sepolia",
    "chain:smoke:local": "node scripts/blockchain-tools.cjs smoke local",
    "chain:smoke:sepolia": "node scripts/blockchain-tools.cjs smoke sepolia",
    "chain:verify:sepolia": "npm run verify:sepolia --workspace=@rcm/contracts",
    "chain:setup:local": "npm run chain:deploy:local && npm run chain:configure:local && npm run chain:check:local",
    "chain:api:test": "powershell -NoProfile -File scripts/Test-BlockchainApi.ps1",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "balanced-match": "^4.0.4"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^2.0.0": "^2.1.7",
    "brace-expansion@^5.0.0": "^5.0.12",
    "decode-uri-component": "^0.5.0",
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.8",
    "image-size": "^2.0.4",
    "postcss": "^8.5.28",
    "query-string": "^9.5.1",
    "react-native-reanimated": "4.5.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
