# a reset URL and the intended email/phone recipient to this provider endpoint.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_URL="https://your-mobile-or-web-app.example/reset-password"
HARDHAT_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
