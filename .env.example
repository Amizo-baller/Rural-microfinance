DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rural_microfinance?schema=public"
API_PORT=3000
NODE_ENV=development
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=15m
